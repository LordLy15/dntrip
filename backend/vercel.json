{
  "version": 2,
  "outputDirectory": "public",
  "publicDirectory": "public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.php"
    },
    {
      "source": "/up",
      "destination": "/api/up.php"
    }
  ],
  "build": {
    "env": {
      "PHP_VERSION": "8.2"
    }
  }
}
