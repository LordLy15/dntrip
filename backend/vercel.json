{
  "version": 2,
  "outputDirectory": "public",
  "cleanUrls": true,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.php",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "src": "/up",
      "dest": "/api/index.php"
    }
  ]
}
