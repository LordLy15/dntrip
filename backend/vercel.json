{
  "framework": null,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.6.1",
      "memory": 256,
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.php"
    },
    {
      "src": "/up",
      "dest": "/api/index.php"
    }
  ]
}
